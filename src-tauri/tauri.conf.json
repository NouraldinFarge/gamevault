{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameVault",
  "identifier": "com.gamevault.portable",
  "version": "0.3.1",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GameVault",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#0A0F1D"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: https://*.steamstatic.com https://*.gog-statics.com https://*.epicgames.com https://*.epicgamescdn.com https://media.graphassets.com; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
